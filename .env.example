# Secrets for config.yaml. Copy this to .env, fill in what you use, delete the rest.
# config.yaml refers to these as ${NAME}; the page never sees them (Atrium's server talks to your services).
# A variable that config.yaml uses but .env doesn't set is reported at startup. Keep this file private: chmod 600 .env
# Give each app the narrowest key it offers (SECURITY.md has a table); Atrium redacts all of these from anything it sends out.

# Home Assistant: best from a separate non-admin user for Atrium → its profile → Security → Long-lived access tokens
HA_TOKEN=
# Plex via Tautulli: Settings → Web Interface → API key
TAUTULLI_KEY=
# qBittorrent: your web UI login
QBIT_USER=
QBIT_PASS=
# Sonarr / Radarr / Prowlarr: Settings → General → API Key
SONARR_KEY=
RADARR_KEY=
PROWLARR_KEY=
# Bazarr: Settings → General → Security → API Key
BAZARR_KEY=
# Seerr / Overseerr / Jellyseerr: Settings → General → API Key
SEERR_KEY=
# Paperless-ngx: best from a separate user with view permissions → My Profile → API Auth Token
PAPERLESS_TOKEN=
# Karakeep: Settings → API Keys → New API key
KARAKEEP_KEY=
# Immich: Account Settings → API Keys → New (read permissions are enough)
IMMICH_KEY=
# Pi-hole v6: Settings → Web interface/API → App password (better than your admin password)
PIHOLE_PASSWORD=
# Uptime Kuma: best an API key (Settings → API Keys): leave KUMA_USER empty and put the key in KUMA_PASSWORD
KUMA_USER=
KUMA_PASSWORD=
# RomM: your login
ROMM_USER=
ROMM_PASSWORD=
# The assistant, if it uses a hosted model (local servers usually need none)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
