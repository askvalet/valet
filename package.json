{
  "name": "valet",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Talk to your homelab. A self-hosted, open-source, AI-native homepage.",
  "repository": "github:askvalet/valet",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server/main.ts & vite",
    "build": "vite build && esbuild src/server/main.ts --bundle --splitting --platform=node --format=esm --target=node22 --outdir=dist/server --chunk-names=[name]-[hash] --loader:.txt=text --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --log-level=warning && echo \"import './server/main.js';\" > dist/server.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "export:pc-model": "esbuild src/web/visuals/pc-model.ts --bundle --format=esm --minify --outdir=${PC_MODEL_OUT:-dist/pc-model}",
    "test": "esbuild test/*.test.ts test/*.test.tsx --bundle --platform=node --format=esm --outdir=.test --out-extension:.js=.test.mjs --packages=external --jsx=automatic --tsconfig=tsconfig.web.json --loader:.css=empty --loader:.txt=text --log-level=warning && node --test .test/*.test.mjs",
    "test:exposure": "node --test --test-concurrency=1 test/exposure.ts",
    "test:hostile": "node --test --test-concurrency=1 test/hostile.ts",
    "eval:inject": "node --env-file-if-exists=.env test/inject.eval.ts",
    "eval:chat": "esbuild test/chat.eval.ts --bundle --platform=node --format=esm --outfile=.test/chat.eval.mjs --packages=external --loader:.txt=text --log-level=warning && node --env-file-if-exists=.env .test/chat.eval.mjs",
    "test:live": "esbuild test/live.ts --bundle --platform=node --format=esm --outfile=.test/live.mjs --packages=external --loader:.txt=text --log-level=warning && node --env-file-if-exists=.env .test/live.mjs",
    "test:services": "esbuild test/live-services.ts --bundle --platform=node --format=esm --outfile=.test/live-services.mjs --packages=external --loader:.txt=text --log-level=warning && node --env-file-if-exists=.env .test/live-services.mjs",
    "docs:services": "esbuild scripts/services-doc.ts --bundle --platform=node --format=esm --outfile=.test/services-doc.mjs --packages=external --loader:.txt=text --log-level=warning && node .test/services-doc.mjs",
    "demo:static": "npm run build && node demo/static/build.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@ai-sdk/mcp": "^2.0.85",
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@ai-sdk/react": "^4.0.153",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "ai": "^7.0.154",
    "border-beam": "1.4.1",
    "cmdk": "^1.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "0.3.2",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
